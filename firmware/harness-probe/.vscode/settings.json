{
  // ===== clangd: 唯一 IntelliSense 引擎 =====
  "clangd.path": "/usr/bin/clangd",
  "clangd.arguments": [
    "--background-index",
    // compile_commands.json 通过 tasks.json 里 Analysis 系列任务生成，
    // 软链到 ${workspaceFolder}/build -> <repo>/BUILD/analysis/<board>，
    // clangd 自动在源码树里发现 build/compile_commands.json（无需此配置项）。
    "--query-driver=/usr/bin/arm-none-eabi-gcc",
    "--query-driver=/opt/arm-gnu-toolchain*/bin/arm-none-eabi-gcc",
    "--query-driver=**/arm-none-eabi-gcc*",
    "--header-insertion=never",
    "--completion-style=detailed",
    "--function-arg-placeholders=true",
    "--all-scopes-completion=true"
  ],
  "clangd.detectExtensionConflicts": true,

  // ===== C/C++ 扩展完全停用，避免与 clangd 打架 =====
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.errorSquiggles": "disabled",

  // ===== 工作区视图：隐藏构建产物 =====
  "files.exclude": {
    "**/build/**": true,
    "**/BUILD/**": true,
    "**/RELEASE/**": true
  },
  "search.exclude": {
    "**/build/**": true,
    "**/BUILD/**": true,
    "**/RELEASE/**": true
  },
  "files.watcherExclude": {
    "**/build/**": true,
    "**/BUILD/**": true,
    "**/RELEASE/**": true
  },

  // ===== 其它 =====
  // PIO 程序集文件按 C++ 高亮。
  "files.associations": {
    "*.pio": "pio"
},

  // ===== CMake Tools: 使用本机 SDK，保持独立构建目录 =====
  // 日常构建通过仓库根目录的 ./build.sh；CMake Tools 仅用于需要时的本地配置。
  "cmake.configureOnOpen": false,
  "cmake.buildDirectory": "${workspaceFolder}/../../BUILD/vscode",
  "cmake.configureSettings": {
    "PICO_SDK_PATH": "${env:PICO_SDK_PATH}",
    "PICO_BOARD": "pico_dualcore"
  }
}
